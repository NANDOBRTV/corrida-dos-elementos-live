# Exemplo de variáveis do Render. Nunca publique valores reais.
PORT=3000
ADMIN_KEY=
# Opcional: necessário para recuperar o estado entre reinícios:
DATABASE_URL=
# Em bancos externos que exijam TLS verificado:
DATABASE_SSL=false

# Pré-lançamento: manter "disabled" até o jogo estar pronto e autorizado para LIVE real.
TIKTOK_LIVE_MODE=disabled
# TIKTOK_USERNAME=nandobr_ofc (somente no Render; não é segredo)
